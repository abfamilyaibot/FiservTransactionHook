<?xml version="1.0" encoding="UTF-8"?>
<jaxb:bindings version="3.0"
               xmlns:jaxb="https://jakarta.ee/xml/ns/jaxb">
    <jaxb:globalBindings generateElementProperty="false"/>

    <jaxb:bindings schemaLocation="CoreApiService.xsd">
        <jaxb:schemaBindings>
            <jaxb:package name="com.dep.integration.transaction.hook.fiserv.dto.jaxb.coreapi"/>
        </jaxb:schemaBindings>
    </jaxb:bindings>

    <jaxb:bindings schemaLocation="CoreApiService_1.xsd">
        <jaxb:schemaBindings>
            <jaxb:package name="com.dep.integration.transaction.hook.fiserv.dto.jaxb.messages"/>
        </jaxb:schemaBindings>
    </jaxb:bindings>

    <jaxb:bindings schemaLocation="CoreApiService_4.xsd">
        <jaxb:schemaBindings>
            <jaxb:package name="com.dep.integration.transaction.hook.fiserv.dto.jaxb.arrays"/>
        </jaxb:schemaBindings>
    </jaxb:bindings>

    <jaxb:bindings schemaLocation="CoreApiService_35.xsd">
        <jaxb:schemaBindings>
            <jaxb:package name="com.dep.integration.transaction.hook.fiserv.dto.jaxb.billpayhistory"/>
        </jaxb:schemaBindings>
    </jaxb:bindings>

    <jaxb:bindings schemaLocation="SoapEnvelope.xsd">
        <jaxb:schemaBindings>
            <jaxb:package name="com.dep.integration.transaction.hook.fiserv.dto.jaxb.envelope"/>
        </jaxb:schemaBindings>
    </jaxb:bindings>
</jaxb:bindings>
