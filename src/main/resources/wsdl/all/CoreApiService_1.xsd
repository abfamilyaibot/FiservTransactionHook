  <xs:complexType name="AccountRelationPhone">
    <xs:annotation>
      <xs:appinfo/>
      <xs:documentation><![CDATA[<summary>
            A specific phone number for an entity.
            </summary>
            <remarks>This class is used by the <see cref="T:AccountRelation" /> class.</remarks>
            <tocexclude />]]></xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element minOccurs="0" name="AreaCode" nillable="true" type="xs:string">
