            <tocexclude />]]></xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element minOccurs="0" name="AccountNumber" nillable="true" type="xs:decimal">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Attribute identifies the account number to link to the agreement.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="CrossAccountDescription" nillable="true" type="xs:string">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Cross account description. This tag is optional. If not provided then the default value is null. 
            Can be used when linking an account to the agreement or for maintenance to an account that is already linked to an agreement.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="CrossAccountTransferFlag" nillable="true" type="xs:boolean">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Cross account transfer flag. This tag is optional. If not provided then the default value is N. 
            Can be used when linking an account to the agreement or for maintenance to an account that is already linked to an agreement.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="CycleDepositLimitAmount" nillable="true" type="xs:double">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Cycle deposit limit amount. This tag is optional. If not provided then the default value comes from MjMiAcctCardAgreementTyp. 
            Can be used when linking an account to the agreement or for maintenance to an account that is already linked to an agreement.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="CycleWithdrawalLimitAmount" nillable="true" type="xs:double">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Cycle withdrawal limit amount. This tag is optional. If not provided then the default value comes from MjMiAcctCardAgreementTyp. 
            Can be used when linking an account to the agreement or for maintenance to an account that is already linked to an agreement.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="InactiveDate" nillable="true" type="xs:dateTime">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            The inactive date is used to de-link the account from the agreement.  Format is MM/DD/YYYY.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="IsCrossAccountTransferRoleRequired" nillable="true" type="xs:boolean">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Attribute identifies whether an account role is required or not while attaching an account as cross account with in agreement. 
            Applicable only when CrossAcctXferYN ='Y'. Default is Y. Valid values are Y or N.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="RelinkAccount" nillable="true" type="xs:boolean">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Indicates if an account should be linked to an agreement.
            When an account has been previously delinked from an agreement, this field indicates the account should be linked to the 
            agreement again and the inactiveDate should be set to null.  An Inactive date should not be sent when relinking an account 
            unless the account should be delinked(Inactivated) at a date in the future.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
