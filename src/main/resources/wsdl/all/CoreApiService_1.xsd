        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="IsCancelPending" nillable="true" type="xs:boolean">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Indicates whether this allotment is pending cancellation.
            Valid values are Y, N. Default is N.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
