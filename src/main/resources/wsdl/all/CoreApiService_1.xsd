    <xs:annotation>
      <xs:appinfo/>
      <xs:documentation><![CDATA[<summary>
            A specific account to be maintained.
            </summary>
            <remarks>This class is used by the <see cref="T:InvestorAccountMaintenanceRequest" /> class.</remarks>
            <tocexclude />]]></xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element minOccurs="0" name="AccountGroupInvestorRateParameters" nillable="true" type="tns:AccountGroupInvestorRateParameter">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            It defines if rate calculation is to be done with account level values.
            The Group Rate parameter must be established on the Group level prior to this setting. 
            This is applicable ONLY for variable accounts.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="AccountNumber" nillable="true" type="xs:long">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation><![CDATA[<summary>
            Attribute identifies the account number to add to the Investor group.
            </summary>
            <remarks>
            <note type="caution"><!-- Failed to insert some or all of included XML --></note>
            </remarks>]]></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="BuyDownSoldAmount" nillable="true" type="xs:double">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Buy Down Sold Amount.  Applicable when the investor loan program is Sold/Servicing Released (SSR) and when the acctgrpacct status is Pending or Approved.  
            The product must be setup with the BYDN/IBAL balance cat/type.If a value is provided and an AcctSubAcct row for BYDN/IBAL does not exist on the account, 
            the AcctSubAcct row will be inserted.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="CurrentStatusCode" nillable="true" type="xs:string">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Tag identifies the status code of the investor relationship to the account.
            If not provided, the default status will be Originating.
            Possible values are ORIG, PEND, APPR
            When Status is PEND or APPR, Group Information is brought to the account level and is available for edit. These values should be reviewed prior to approving a loan for sale.
            All the following tags should contain values when values need to be different than group level values AND target status is either PEND or APPR. In case of ORIG, only &amp;lt;InvrLoanNbr&amp;gt; can be modified.
            Cannot migrate backward in the same group. Meaning, if in APPR already can't go back to PEND, if PEND already, can't go back to ORIG.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="EscrowSoldAmount" nillable="true" type="xs:double">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Escrow Sold Amount.  Applicable when the investor loan program is Sold/Servicing Released (SSR) and when the acctgrpacct status is Pending or Approved.  
            The product must be setup with the ESC/IBAL balance cat/type.If a value is provided and an AcctSubAcct row for ESC/IBAL does not exist on the account, 
            the AcctSubAcct row will be inserted.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="FirstPaymentSoldDate" nillable="true" type="xs:dateTime">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Tag identifies the date on which the first payment should be remitted to the investor. 
            The DAY for the Next Payment Due Date and the First Payment Sold Date must be the same, i.e. 1st, 10th, 15th. 
            Default Format is MM/DD/YYYY.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="GuaranteeFeeRate" nillable="true" type="xs:double">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Applicable for Scheduled/Scheduled Investor Loan Programs. 
            The percent is used to compute the Guaranty Fee due to the investor. Value should be between 0 and 1.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="InvestorGroupNumber" nillable="true" type="xs:long">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation><![CDATA[<summary>
            Attribute identifies the group number to which account needs to be added.
            </summary>
            <remarks>
            <note type="caution"><!-- Failed to insert some or all of included XML --></note>
            </remarks>]]></xs:documentation>
        </xs:annotation>
      </xs:element>
