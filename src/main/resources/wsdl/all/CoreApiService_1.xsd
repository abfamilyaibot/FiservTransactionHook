      <xs:appinfo/>
      <xs:documentation><![CDATA[<summary>
            A specific entity that has a role on the account.
            </summary>
            <remarks>This class is used by the <see cref="T:AccountRolesInquiryResponse" /> class.</remarks>
            <tocexclude />]]></xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element minOccurs="0" name="Addresses" nillable="true" type="tns:ArrayOfAccountRelationAddress">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Contains postal addresses.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="BirthDate" nillable="true" type="xs:dateTime">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Birth date of the person, when entityTypCd = PERS.  Format is MM/DD/YYYY.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="DataWarehouseName" nillable="true" type="xs:string">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            The full name concatenated the same way it is stored in eis_dw.personrecords.fullname
            (PERS) and eis_dw.orgrecords.orgname (ORG)
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="EntityName" nillable="true" type="xs:string">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Person Full Name when entityTypCd = PERS, Organization name when entityTypCd = ORG.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="EntityNumber" nillable="true" type="xs:decimal">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Attribute identifies the PersNbr or OrgNbr (depending on the value of entityTypCd).
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="EntityTypeCode" nillable="true" type="xs:string">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Attribute identifies what type of value is in the entityNbr attribute. PERS = Person, ORG = Organization.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="FirstName" nillable="true" type="xs:string">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Person First Name when entityTypCd = PERS.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="IsTaxOwner" nillable="true" type="xs:boolean">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Attribute indicates whether the entity is the tax owner on the account.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="IsValid" nillable="true" type="xs:boolean">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Attribute indicates whether the entity is valid.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="LastName" nillable="true" type="xs:string">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Person Last Name when entityTypCd = PERS.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="MemberNumber" nillable="true" type="xs:decimal">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Member agreement number.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="MiddleName" nillable="true" type="xs:string">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Middle Name when entityTypCd = PERS.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="OrgTaxIds" nillable="true" type="tns:ArrayOfOrgTaxID">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            A collection of one or more identification records for this org.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="Phones" nillable="true" type="tns:ArrayOfAccountRelationPhone">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Contains phone numbers for this entity.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="Roles" nillable="true" type="q23:ArrayOfRoleDetail" xmlns:q23="http://schemas.datacontract.org/2004/07/OpenSolutions.CoreApiService.Services.Messages.Common">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Contains roles for this entity for this account.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="TaxId" nillable="true" type="xs:string">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Tax identification number. Value will be masked if the requesting user does not have
            authority to view tax ID information. Example of person's tax ID masked: ***-**-8989.
            For Organizations, it would look like 12-****789.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:element name="AccountRelation" nillable="true" type="tns:AccountRelation"/>
  <xs:complexType name="ArrayOfAccountRelationAddress">
    <xs:sequence>
      <xs:element minOccurs="0" maxOccurs="unbounded" name="AccountRelationAddress" nillable="true" type="tns:AccountRelationAddress"/>
    </xs:sequence>
  </xs:complexType>
  <xs:element name="ArrayOfAccountRelationAddress" nillable="true" type="tns:ArrayOfAccountRelationAddress"/>
  <xs:complexType name="AccountRelationAddress">
    <xs:annotation>
      <xs:appinfo/>
      <xs:documentation><![CDATA[<summary>
            A specific address for an entity.
            </summary>
            <remarks>This class is used by the <see cref="T:AccountRelation" /> class.</remarks>
            <tocexclude />]]></xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element minOccurs="0" name="AddressLines" nillable="true" type="tns:ArrayOfRoleAddressLine">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Wrapper tag that identifies multiple address lines.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="AddressNumber" nillable="true" type="xs:decimal">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Attributes indicates the unique address number of the address.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="AddressUseCode" nillable="true" type="xs:string">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Attribute indicates the address use, e.g., PRI = Primary, SEA = Seasonal, BUS = Business.
            Valid values are defined by ADDRUSE table.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="CensusTractNumber" nillable="true" type="xs:string">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            The Census Tract Number from the Census Bureau.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="CityName" nillable="true" type="xs:string">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            The city name of the address.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="CountryCode" nillable="true" type="xs:string">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            The Country Code is used to identify the country of the address, e.g., USA.
            Valid values are defined by CTRY table.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="CountrySubDivisionCode" nillable="true" type="xs:string">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            The Country Subdivision Code is used to identify the subdivision of a country.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="IsElectronic" nillable="true" type="xs:boolean">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Attribute indicates whether or not this is an electronic address.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="MailCode" nillable="true" type="xs:string">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            The country mail code for non-U.S. addresses.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="SMSANumber" nillable="true" type="xs:string">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            The Metropolitan Statistical Number for this address.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="SeasonalAddress" nillable="true" type="q24:SeasonalAddress" xmlns:q24="http://schemas.datacontract.org/2004/07/OpenSolutions.CoreApiService.Services.Messages.Common">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            This field identifies seasonal address information.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="StateCode" nillable="true" type="xs:string">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            The state code for the address.  Valid values are defined by STATE table.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="ZipCode" nillable="true" type="xs:string">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            The 5-digit ZIP code of the address
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="ZipSuffix" nillable="true" type="xs:string">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            The 4-digit ZIP code suffix of the address.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:element name="AccountRelationAddress" nillable="true" type="tns:AccountRelationAddress"/>
  <xs:complexType name="ArrayOfRoleAddressLine">
    <xs:sequence>
      <xs:element minOccurs="0" maxOccurs="unbounded" name="RoleAddressLine" nillable="true" type="tns:RoleAddressLine"/>
    </xs:sequence>
  </xs:complexType>
  <xs:element name="ArrayOfRoleAddressLine" nillable="true" type="tns:ArrayOfRoleAddressLine"/>
  <xs:complexType name="RoleAddressLine">
    <xs:annotation>
      <xs:appinfo/>
      <xs:documentation><![CDATA[<summary>
            A specific address line for an address related to an entity.
            </summary>
            <remarks>This class is used by the <see cref="T:AccountRelationAddress" /> class.</remarks>
            <tocexclude />]]></xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element minOccurs="0" name="AddressLineLastUpdatedDate" nillable="true" type="xs:dateTime">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Attribute identifies the Last Date when Address is Updated.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="AddressLineNumber" nillable="true" type="xs:decimal">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Attribute indicates the line number of the record.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="AddressLineText" nillable="true" type="xs:string">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            The address line text, e.g., 805 South St.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="AddressLineTypeCode" nillable="true" type="xs:string">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Attribute indicates the address line type, e.g., ST = Street, APTN = Apartment.  Valid values are defined by ADDRLINETYP table.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:element name="RoleAddressLine" nillable="true" type="tns:RoleAddressLine"/>
  <xs:complexType name="ArrayOfOrgTaxID">
