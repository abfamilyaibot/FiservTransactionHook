        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Determines which accounts with interest credits will be placed on a single check.
            Valid values are Y, N. Default is N.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
