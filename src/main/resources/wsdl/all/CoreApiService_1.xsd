  <xs:complexType name="Fund">
    <xs:annotation>
      <xs:appinfo/>
      <xs:documentation><![CDATA[<summary>
            A specific fund record.
            </summary>
            <remarks>This class is used by the <see cref="T:MonetaryTransactionRequest" /> class.</remarks>
            <tocexclude />]]></xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element minOccurs="0" name="ClearingCategoryCode" nillable="true" type="xs:string">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Attribute identifies the Core clearing category code to use for the Fund Type. 
            These codes define the fund type code and are mostly used for identifying check hold lengths in conjunction with Fund Type Detail. 
            CASH, EL, and JE have predefined valid values while CHK depends on the institution. 
            CASH = IMED, EL = IMED, and JE = IMED.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="FundAmount" nillable="true" type="xs:double">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Amount of the funds used for the transaction. Multiple funds are supported.
            For a Cash and Check deposit the request needs at least two fund rows. 
            Actual value required for funds. Funds In are positive and Funds Out are negative.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="FundTypeCode" nillable="true" type="xs:string">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Attribute identifies the Core Fund Type code of the transaction. 
            Some of the valid values are common for all OSI clients, others are Client specific. 
            Common valid values are CASH (Cash), EL (Electronic), JE (Journal Entry). 
            Check Fund Type Code is Client specific but will mostly be CHK.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="FundTypeDetailCode" nillable="true" type="xs:string">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Attribute identifies the Core detail code to use for the Fund Type. 
            These codes define the fund type code and are mostly used for identifying check hold lengths.
            CASH, EL, and JE have predefined valid values while CHK depends on the institution. 
            CASH = ALL, EL = INTR, and JE = ALL.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
