        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="ReceivableNumber" nillable="true" type="xs:long">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Identifies the Receivable Number for the Excess Payment.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="ReceivablePaymentAmount" nillable="true" type="xs:double">
        <xs:annotation>
