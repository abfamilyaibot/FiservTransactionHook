      <xs:element minOccurs="0" maxOccurs="unbounded" name="AccountUserField" nillable="true" type="tns:AccountUserField"/>
    </xs:sequence>
  </xs:complexType>
  <xs:element name="ArrayOfAccountUserField" nillable="true" type="tns:ArrayOfAccountUserField"/>
  <xs:complexType name="AccountUserField">
    <xs:annotation>
      <xs:appinfo/>
      <xs:documentation><![CDATA[<summary>
            A specific user field to add to the account.
            </summary>
            <remarks>This class is used by the <see cref="T:MaintenanceAccount" /> class.</remarks>
            <tocexclude />]]></xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element minOccurs="0" name="IsCopyToMasterLine" nillable="true" type="xs:boolean">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            This is used for master line processing. If this user field applies only to the sub loan, then the value should be N. 
            If the value applies to the sub loan and master line then this value should be Y. The stored procedure default is N.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="UserFieldCode" nillable="true" type="xs:string">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Attribute identifies user field code. Valid values are defined by USERFIELD table.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="UserFieldValue" nillable="true" type="xs:string">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            User field value
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:element name="AccountUserField" nillable="true" type="tns:AccountUserField"/>
  <xs:complexType name="ArrayOfDeferredFee">
    <xs:sequence>
      <xs:element minOccurs="0" maxOccurs="unbounded" name="DeferredFee" nillable="true" type="tns:DeferredFee"/>
    </xs:sequence>
  </xs:complexType>
  <xs:element name="ArrayOfDeferredFee" nillable="true" type="tns:ArrayOfDeferredFee"/>
  <xs:complexType name="DeferredFee">
    <xs:annotation>
      <xs:appinfo/>
      <xs:documentation><![CDATA[<summary>
            The deferred fee/cost settings to associate with the account.
            </summary>
            <remarks>This class is used by the <see cref="T:MaintenanceAccount" /> class.</remarks>
            <tocexclude />]]></xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element minOccurs="0" name="BalanceCategoryCode" nillable="true" type="xs:string">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            The Balance Category identifies the specific type of deferred fee or costs. Financial institution defined.
            Valid values are in the BalCatCd column in BalCatBalTyp table when the BalTypCd = FEE or COST.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="BalanceTypeCode" nillable="true" type="xs:string">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            The Balance Type identifies whether the item is a Fee or Cost. Fee would be used for money received and required to amortize. 
            Cost is used for any expenses to be amortized
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="FeeAmortizationMethod" nillable="true" type="xs:string">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Will be used only when copyCalcVarsToAcctLevelYN = 'Y'
            If provided will overwrite the value of Product default of CalcVarCd= 'AMTH' with the value of the Tag. Validated for valid values from CalcvarValue Table.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
