        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="IsFamily" nillable="true" type="xs:boolean">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Used to update HSAAcctGrp.FamilyYN (coverage type Y=Family, N=Individual).  
            In order to maintain this column the account must be linked to an HSA account group.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="IsHaveSystemCalculateInterestRate" nillable="true" type="xs:boolean">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            If opening an account in an active status then you can ask the system to calculate the interest rate at the time of origination. 
            By default this flag is N and the interest rate gets calculated when the first monetary transaction is performed.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="IsPassbook" nillable="true" type="xs:boolean">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Identifies whether this account is a passbook account.Valid values are Y, N.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="IsPointsReported" nillable="true" type="xs:boolean">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Identifies if points are to be reported for the account.  Valid values are Y, N.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="IsPrimaryUseCommercial" nillable="true" type="xs:boolean">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            identifies whether the account is used primarily for commercial purposes or personal banking purposes.Valid values are Y or N. The default value of this tag is N.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="IsRegulationEOverDraftOptIn" nillable="true" type="xs:boolean">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Attribute identifies the RegEODOptIn.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="IsReported1098" nillable="true" type="xs:boolean">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Identifies if the interest earned is to be reported for the account.  Valid values are Y, N.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="IsRetirement" nillable="true" type="xs:boolean">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Used to update Acct.RetirementYN. If not provided then the database default of N will be assigned. 
            If using 7719 to create a masterline (umbrella) account at the same time then the subordinate account will automatically 
            get a value of Y when the master account major type code is RTMT.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="IsShareStatement" nillable="true" type="xs:boolean">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Attribute indicates whether the StmtAcct should be set to the tax reported for member's share account.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="IsTeaserRate" nillable="true" type="xs:boolean">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Indicates whether this interest rate is a teaser rate. Valid values are Y, N.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="IsUseProductDefaultDeliveryMethod" nillable="true" type="xs:boolean">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            attribute identifies the product level Delivery Method to use instead of overriden
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="LockOutFlags" nillable="true" type="tns:ArrayOfLockOutFlag">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Wrapper tag to identify any lockout flags to add to the new account.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="MailAddressUseCode" nillable="true" type="xs:string">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Identifies which address is used for mailing purposes for the account.
            When AcctMaintYN = Y a value of NONE will null out the existing column value.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="MailTypeCode" nillable="true" type="xs:string">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Identifies which of the various mailing options pertain to the account.
            When AcctMaintYN = Y a value of NONE will null out the existing column value.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="MajorAccountTypeCode" nillable="true" type="xs:string">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Attribute identifies the major account type code of the account. Required for new account.Valid values are defined in the MJACCTTYP table.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="MasterLineData" nillable="true" type="tns:MasterLineData">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Wrapper tag used to identify if the loan being created is a Master Line Loan.
            If supplied, the Master Line account will also be created and linked to this loan.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="Monetary" nillable="true" type="tns:Monetary">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Contains data from a SWIM file.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="NCUACategoryCode" nillable="true" type="xs:string">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Supplying a value in this tag will overwrite the product default for NCUA category code - Acct.NCUACatCd.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="Organizations" nillable="true" type="tns:ArrayOfOrganization">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Wrapper tag to identify the multiple organizations to link to the account.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="OriginalBalance" nillable="true" type="xs:double">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Identifies the original balance for the account.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="OriginalTerm" nillable="true" type="xs:long">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Identifies original term for the account. Applicable for both creation and maintenance.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="OwnershipCode" nillable="true" type="xs:string">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Attribute identifies the ownership type code.  Valid values are defined in the OWNTYP table.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="PaymentAmount" nillable="true" type="xs:double">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Identifies the payment amount for the account.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="PaymentCalendarPeriodCode" nillable="true" type="xs:string">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Identifies the payment calendar period code for which the payment applies.
            Valid values are defined in the CALPERIOD table.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="Persons" nillable="true" type="tns:ArrayOfAccountMaintenancePerson">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Wrapper tag to identify the multiple persons to link to the account.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="ReplaceAccountOwner" nillable="true" type="xs:boolean">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            When provided will replace the tax owner for an account. A new Tax Owner must be provided when this attribute has a value of true. Default is false. Applicable when IsAccountMaintenance is true.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="StatementAccountNumber" nillable="true" type="xs:long">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Identifies the statement account (if any) to link the new account to. If a value is sent in this node and the ShareStmtYN attribute is set to Y on the Account, the attribute will override the value of this field.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="TaxReportingOverrides" nillable="true" type="tns:ArrayOfTaxReportingOverride">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            The wrapper tag for Tax Reported For Owner of an account. This will represent information for both Person and organization.
            Value of this tag can be used for updating the 1099 INT tax reporting for an account.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="WarningFlags" nillable="true" type="tns:ArrayOfWarningFlag">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Wrapper tag to identify any warning flags to add to the new account.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:element name="MaintenanceAccount" nillable="true" type="tns:MaintenanceAccount"/>
  <xs:complexType name="ArrayOfAccountDocumentRequest">
    <xs:sequence>
      <xs:element minOccurs="0" maxOccurs="unbounded" name="AccountDocumentRequest" nillable="true" type="tns:AccountDocumentRequest"/>
    </xs:sequence>
  </xs:complexType>
  <xs:element name="ArrayOfAccountDocumentRequest" nillable="true" type="tns:ArrayOfAccountDocumentRequest"/>
  <xs:complexType name="AccountDocumentRequest">
    <xs:annotation>
      <xs:appinfo/>
      <xs:documentation><![CDATA[<summary>
            A specific document request for an account.
            </summary>
            <remarks>This class is used by the <see cref="T:MaintenanceAccount" /> class.</remarks>
            <tocexclude />]]></xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element minOccurs="0" name="CommentText" nillable="true" type="xs:string">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Free form text comments.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="DocumentRequestNumber" nillable="true" type="xs:long">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Attribute identifies the system assigned value unique to each document request. Used only to update an existing DOCREQ row.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="DocumentTypeCode" nillable="true" type="xs:string">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Attribute identifies the document type of the request.Valid values are defined in the DOCTYP table.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="EffectiveDate" nillable="true" type="xs:dateTime">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Identifies the effective date of the document request.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="FollowupDays" nillable="true" type="xs:long">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Follow up days over ride. Default value comes from DOCTYP.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="FollowupDays2" nillable="true" type="xs:long">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Follow up days 2 over ride. Default value comes from DOCTYP.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="FrequencyCalendarPeriodCode" nillable="true" type="xs:string">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Identifies the frequency of the document request.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="GraceDays" nillable="true" type="xs:long">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Grace days over ride. Default value comes from DOCTYP.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="InactiveDate" nillable="true" type="xs:dateTime">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Identifies the inactive date for the document request.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="NextDueDate" nillable="true" type="xs:dateTime">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Identifies the next due date for the document request.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:element name="AccountDocumentRequest" nillable="true" type="tns:AccountDocumentRequest"/>
  <xs:complexType name="AccountExternalOrganizationIdentification">
    <xs:annotation>
      <xs:appinfo/>
      <xs:documentation><![CDATA[<summary>
            The external organization information to add to the account.
            </summary>
            <remarks>This class is used by the <see cref="T:MaintenanceAccount" /> class.</remarks>
            <tocexclude />]]></xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element minOccurs="0" name="EffectiveDate" nillable="true" type="xs:dateTime">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            The effective date for this external account. Defaults to the system post date if not provided.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="ExternalAccountIdNumber" nillable="true" type="xs:string">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            The customer's/member's alpha numeric account number value at the External organization specified in this tag. This new field value is
            processed for External account number value and will be given priority over existing ExternalAccountNumber field. If user enters value
            in both the fields then the value passed in existing ExternalAccountNumber field will be ignored.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="ExternalAccountNumber" nillable="true" type="xs:long">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            The customer's/member's account number at the external organization specified in tag 1802. This field only accepts a numeric value.
            This field is obsolete. Use the "ExternalAccountIdNumber" which accepts alpha numeric characters for External account number value.
            This field has been retained for backwards compatibility only.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="ExternalAmount" nillable="true" type="xs:double">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            The escrow amount held by the external organization specified in tag 1802.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="ExternalAmountEffectiveDate" nillable="true" type="xs:dateTime">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            The effective date of the escrow amount specified in tag 1805.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="ExternalIdentificationTypeCode" nillable="true" type="xs:string">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            The institution-defined external ID type code for the org specified.  Valid values are defined in the EXTIDTYP table.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="ExternalOrganizationNumber" nillable="true" type="xs:long">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            The DNA organization number for the external organization.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="InactiveDate" nillable="true" type="xs:dateTime">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            The inactive date for this external account.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:element name="AccountExternalOrganizationIdentification" nillable="true" type="tns:AccountExternalOrganizationIdentification"/>
  <xs:complexType name="AccountLoanDetail">
    <xs:annotation>
      <xs:appinfo/>
      <xs:documentation><![CDATA[<summary>
            Information specific to a loan account.
            </summary>
            <remarks>This class is used by the <see cref="T:MaintenanceAccount" /> class.</remarks>
            <tocexclude />]]></xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element minOccurs="0" name="AccountHolds" nillable="true" type="tns:ArrayOfAccountMaintenanceAccountHold">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            A collection of one or more account holds.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="AccountInterestHistoryInformations" nillable="true" type="tns:ArrayOfAccountInterestHistoryInformation">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Wrapper tag to identify rate and accrued interest configuration options.
            balCatCd Attribute to specify the balance category. Default if not provided is NOTE
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="AccountLoanFHLB" nillable="true" type="tns:AccountLoanFHLB">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Wrapper tag for FHLB loan indicator section.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="AccountLoanInformation" nillable="true" type="tns:AccountLoanInformation">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Wrapper tag for the loan-specific dates, codes, and categories.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="AccountLoanLimitHistory" nillable="true" type="tns:AccountLoanLimitHistory">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Wrapper tag for the credit limit for line of credit loan accounts section.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="AccountLoanRepricingPlans" nillable="true" type="tns:ArrayOfAccountLoanRepricingPlan">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            The wrapper Tag for AcctLoanRepricPlan Tag. This is supported when maintenance mode is false
            This tag is used to send in AcctLoanRepricPlanOptInt Information.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="AccountMemoBalances" nillable="true" type="tns:ArrayOfAccountMemoBalance">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Wrapper tag for the Memo Balance Information section.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="AccountPaymentHistoryInformation" nillable="true" type="tns:AccountPaymentHistoryInformation">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Wrapper tag to identify loan payment amounts and frequency.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="AccountPaymentHistoryInformations" nillable="true" type="tns:ArrayOfAccountPaymentHistoryInformation">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            A collection of one or more loan payment amounts and frequency.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="AccountReviewHistory" nillable="true" type="tns:AccountReviewHistory">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Wrapper tag to identify the loan review information.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="AccountSubAccountInformations" nillable="true" type="tns:ArrayOfAccountSubAccountInformation">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Wrapper tag of account sub account information 
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="Allotment" nillable="true" type="tns:AccountMaintenanceAllotment">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Wrapper tag to identify the Allotment information section (does not include Scheduled Allotments).
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="AssetBasedLendingAmount" nillable="true" type="tns:AssetBasedLendingAmount">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            The amount to reduce the available account balance for a revolving credit line.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="Collaterals" nillable="true" type="tns:ArrayOfCollateral">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            A collection of one or more collateral hold accounts.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="DealerInformation" nillable="true" type="tns:DealerInformation">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Wrapper tag to identify the Dealer/indirect settings for the loan.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="DrawAccountInformation" nillable="true" type="tns:DrawAccountInformation">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Wrapper tag to identify overdraft account information.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="EscrowInformation" nillable="true" type="tns:EscrowInformation">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Wrapper tag to identify the escrow information for the loan.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="FHLB" nillable="true" type="tns:FHLB">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Wrapper tag for the Federal Home Loan Bank information for the loan.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="FutureMinorAccountType" nillable="true" type="tns:FutureMinorAccountType">
        <xs:annotation>
