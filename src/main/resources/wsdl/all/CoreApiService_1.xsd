        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Indicates whether this allotment is pending a change.
            Valid values are Y, N. Default is N.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
