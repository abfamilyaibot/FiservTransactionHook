        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Tag value contains the account number assigned by the investor
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="NoteHolderCode" nillable="true" type="xs:string">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Indicates who will physically possess the original executed note. 
            Valid values from the NoteHolder table.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="OriginatingInvestorRate" nillable="true" type="xs:double">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Tag identifies the rate paid to the investor organization. The default value will be taken from group. 
            If overriding, It should be equal to difference between Loan rate and ServFeePct (If ServFeeRateMethCd is chosen as ―RATE‖).
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="PercentOwned" nillable="true" type="xs:double">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Tag identifies the percent of principal the investor purchased for this Account.
            Default value will come from group level.
            Value should be between 0 and 1.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="ServiceFeeAmount" nillable="true" type="xs:double">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Tag identifies the flat amount to be charged as Service fee. 
            Applicable only if the Flat Amount (AMT) is selected as Service Fee Rate Method.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="ServiceFeePercent" nillable="true" type="xs:double">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Tag identifies the rate to be charged as Service fee. 
            Applicable only if the Percent of Interest Payment (RATE) is selected as Service Fee Rate Method.
            Value should be between 0 and 1.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="ServiceFeeRateMethodCode" nillable="true" type="xs:string">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Tag identifies the method used to calculate the service fee rate. Methods are:
            1)Flat Amount (AMT): Service fee will be a flat amount value.
            2)Percent of Interest Payment (RATE) Service fee will be a calculated on the basis of service fee rate.
            If there is no service fee, select Percent of Interest Payment and indicate the percentage as zero.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="SoldAmount" nillable="true" type="xs:double">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Tag identifies the sold amount. Applicable only if CurrStatCd is PEND or APPR. 
            Default value will be Percent owned (at group level) multiplied with current Note Balance of account.
            If loan program is released (INVRLP.ReleasedYN = Y), SoldAmt is always equal to Current balance.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="SoldDate" nillable="true" type="xs:dateTime">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            The date to be used when a loan is sold to an investor mid-month to split the accruals correctly between the financial institution and the investor.
            Format is MM/DD/YYYY.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:element name="AccountInvestor" nillable="true" type="tns:AccountInvestor"/>
  <xs:complexType name="AccountGroupInvestorRateParameter">
    <xs:annotation>
      <xs:appinfo/>
      <xs:documentation><![CDATA[<summary>
            The account group investor rate parameter information.
            </summary>
            <remarks>This class is used by the <see cref="T:AccountInvestor" /> class.</remarks>
            <tocexclude />]]></xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element minOccurs="0" name="CalculationScheduleNumber" nillable="true" type="xs:long">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Active only if Rate Recalculation Method is "Add Investor Margin"(AMGN) - Tag identifies the Rate Schedule (index) to be used for rate recalculation.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="GuranteedServiceSpreadPercent" nillable="true" type="xs:double">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Active only if Rate Recalculation Method is "Add Investor Margin"(AMGN) - Tag identifies the minimum guaranteed spread between the investor and base rates of the life of the account.
            Value should be between 0 and 1.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="IsAccountLevel" nillable="true" type="xs:boolean">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Attribute will define if the variables required for calculation will be copied from the group level to the account level. 
            Valid Values Y or N. The default is N.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="IsProcessOverrides" nillable="true" type="xs:boolean">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Attribute identifies whether or not to override the group level rate parameters with the values in the below tags.
            If a value of Y is provided then you must provide values in all applicable tags below, even if unchanged. 
            NULL values will be taken since changing the RateRecalcMethCd may mean that some other columns need their values removed.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="IsRateChangeWithLoan" nillable="true" type="xs:boolean">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            The tag identifies whether the investor rate should be computed at the same time the base loan rate is computed, accept the default of "Y"
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="MarginPercent" nillable="true" type="xs:double">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Active only if Rate Recalculation Method is "Add Investor Margin"(AMGN) - Tag identifies the Margin that should be added to the Index to derive the new investor rate.
            Value should be between 0 and 1.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="MaximumInvestorRate" nillable="true" type="xs:double">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Active only if Rate Recalculation Method is "Add Investor Margin"(AMGN) - Tag identifies the maximum allowable investor rate over the life of the account.
            Value should be between 0 and 1.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="MaximumRateChangePerReview" nillable="true" type="xs:double">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Active only if Rate Recalculation Method is "Add Investor Margin"(AMGN) - Tag identifies the maximum allowable investor rate change per review.
            Value should be between 0 and 1.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="MinimumInvestorRate" nillable="true" type="xs:double">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Active only if Rate Recalculation Method is "Add Investor Margin"(AMGN) - Tag identifies the minimum allowable investor rate over the life of the account.
            Value should be between 0 and 1.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="RateChangeCalculationPeriodCode" nillable="true" type="xs:string">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Only if RateChangewithLnYN= N. Tag identifies the frequency of how often the investor rate should change. Mandatory if RateChangewithLnYN= N
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="RateChangeLeadDays" nillable="true" type="xs:long">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Only if RateChangewithLnYN= N. Tag identifies the number of days before the base rate changes that the investor rate should change. 
            Mandatory if RateChangewithLnYN= N
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="RateParameterEffectiveDate" nillable="true" type="xs:dateTime">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            The tag value identifies the Effective Date when the new rate parameters should take effect.
            If not provided then the current system post date will be used. Default format is MM/DD/YYYY.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="RateRecalculationMethodCode" nillable="true" type="xs:string">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Tag identifies the method used to calculate a new investor. Methods are:
            1) Add Investor Margin (AMGN) New Investor Rate is determined by adding an investor margin to the corresponding index and then checking all applicable rate caps
            2) Maintain Differential (MDIF) New Investor Rate is determined by maintaining the differential between the current note rate and the current investor loan rate (Constant Margin).
            3) Subtract Service Fee Rate (SSFE) New Investor Rate is determined by subtracting the service fee rate from the new note rate
            NOTE: If RateChangewithLnYN= N, the only Rate Recalculation Method option is "Add Investor Margin".
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="RoundingMethodCode" nillable="true" type="xs:string">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Active only if Rate Recalculation Method is "Add Investor Margin"(AMGN) - Tag identifies the Rounding Method to be used during rate recalculation
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
