          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Attribute identifies the account that received the Stop.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="StopSequenceNumber" nillable="true" type="xs:long">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Attribute identifies the unique number within an account assigned to the ACH Stop.
            &lt;/summary></xs:documentation>
        </xs:annotation>
      </xs:element>
