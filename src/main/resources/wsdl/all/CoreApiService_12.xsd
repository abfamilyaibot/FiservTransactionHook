        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="TransactionId" nillable="true" type="xs:string">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            NOW network assigned transaction id for original transaction
            &lt;/summary>
            &lt;remarks>
            &lt;/remarks></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="TransactionOriginatorId" nillable="true" type="xs:string">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Enduser friendly application reference name. Ex. POPMONEY
             &lt;/summary>
             &lt;remarks>
             &lt;/remarks></xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:element name="NOWMonetaryTransactionRequest.NetworkInfo" nillable="true" type="tns:NOWMonetaryTransactionRequest.NetworkInfo"/>
