  <xs:complexType name="NOWMonetaryTransactionRequest.AMLDebtorInfo">
    <xs:annotation>
      <xs:appinfo/>
      <xs:documentation><![CDATA[<summary>
            Debtor detail for Anti-Money Laundering (AML). Provided with Credit transaction activity only.
            </summary>
            <remarks>This class is used by the <see cref="!:NOWMonetaryTransactionResponse" /> class.</remarks>
            <tocexclude />]]></xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element minOccurs="0" name="Account" nillable="true" type="xs:string">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Debtor’s Account number funding the credit transaction.
            Note: The account number can be alphanumeric
            &lt;/summary>
            &lt;remarks>
            &lt;/remarks></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="Address1" nillable="true" type="xs:string">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Address of the Person/Organization originating the credit transaction.
            &lt;/summary>
            &lt;remarks>
            &lt;/remarks></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="Address2" nillable="true" type="xs:string">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Address of the Person/Organization originating the credit transaction.
            &lt;/summary>
            &lt;remarks>
            &lt;/remarks></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="Address3" nillable="true" type="xs:string">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Address of the Person/Organization originating the credit transaction.
            &lt;/summary>
            &lt;remarks>
            &lt;/remarks></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="BusinesName" nillable="true" type="xs:string">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Business name originating the credit transaction.
            &lt;/summary>
            &lt;remarks>
            &lt;/remarks></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="City" nillable="true" type="xs:string">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            City location of the Person/Organization originating credit transaction
            &lt;/summary>
            &lt;remarks>
            &lt;/remarks></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="Country" nillable="true" type="xs:string">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            ISO 3166 Country code of the Person/Organization originating credit transaction
            &lt;/summary>
            &lt;remarks>
            &lt;/remarks></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="FinancialInstitution" nillable="true" type="xs:string">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Federal Reserve ABA Routing Number of originating financial institution.
            &lt;/summary>
            &lt;remarks>
            &lt;/remarks></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="FirstName" nillable="true" type="xs:string">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            First name of the person originating the credit transaction.
            &lt;/summary>
            &lt;remarks>
            &lt;/remarks></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="LastName" nillable="true" type="xs:string">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Last name of the person originating the credit transaction.
            &lt;/summary>
            &lt;remarks>
            &lt;/remarks></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="MiddleName" nillable="true" type="xs:string">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Middle name of the person originating the credit transaction.
            &lt;/summary>
            &lt;remarks>
            &lt;/remarks></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="PostalCode" nillable="true" type="xs:string">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            Zip/Postal code of the Person/Organization originating credit transaction
            &lt;/summary>
            &lt;remarks>
            &lt;/remarks></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="StateProvince" nillable="true" type="xs:string">
        <xs:annotation>
          <xs:appinfo/>
          <xs:documentation>&lt;summary>
            State or Province of the Person/Organization originating credit transaction
            &lt;/summary>
            &lt;remarks>
            &lt;/remarks></xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:element name="NOWMonetaryTransactionRequest.AMLDebtorInfo" nillable="true" type="tns:NOWMonetaryTransactionRequest.AMLDebtorInfo"/>
