  <xs:complexType name="TransactionInput">
    <xs:annotation>
      <xs:appinfo/>
      <xs:documentation><![CDATA[<summary>
             The beginning wrapper tag for the entire set of transaction requests.
             </summary>
             <example>
             <code numberLines="true" lang="C#">
              // Initialize Transaction Input
              var tran = new CoreApi.TransactionInput();
              var request = new CoreApi.OrgDetailInquiryRequest();
              tran.Input = new CoreApi.Input();
              tran.Input.Requests = new CoreApi.RequestBase[1]; // or however many are needed in the application
            
              // Set up User Authentication
              tran.Input.UserAuthentication = new CoreApi.UAInput();
              tran.Input.UserAuthentication.ApplNumber = long.Parse(capiApplNbr);
              tran.Input.UserAuthentication.AuthorizationType = AuthTypes.SingleSignOn;
              // The property name 'tran.Input.UserAuthentication.PSWD' may have changed in past so please check before running this code.
              tran.Input.UserAuthentication.PSWD = whoIsTicket;
              tran.Input.UserAuthentication.NetworkNodeName = ntwkNode;
            
              // Set up individual request(s)
              tran.Input.Requests[0] = request;
              request.OrgNumber = Decimal.Parse(orgNbrStr);
            
              // Call service
              bool callOK = false;
              CoreApi.TransactionOutput output = null;
              try
              {
                  System.ServiceModel.Channels.Binding binding = new System.ServiceModel.BasicHttpBinding();
                  var endPointAddress = // hard coded in this example...this should come from a calcvar in a production DNAapp
                      new System.ServiceModel.EndpointAddress("http://localhost/OpenSolutions.CoreApiService.Services.WcfHost_deploy/CoreApiService.svc/Soap11");    
                  var client = new CoreApiServiceClient(binding, endPointAddress);
                  output = client.SubmitRequest(tran);
                  callOK = true;
              }
              catch (Exception ex)
              {
                  // handle exception
                  throw;
              }
             
              // Process output
              if (callOK)
              {
                  CoreApi.OrgDetailInquiryResponse response = (CoreApi.OrgDetailInquiryResponse)output.Output.Responses[0];    
                         
                  // First see if there was an error
                  if (response.Errors != null)
                  {
                      this.QueryResultTextArea.Text = "Core Api returned an error message: " + response.Errors[0].ErrorMessage;
                  }
                  else
                  {
                      this.QueryResultTextArea.Text = "Received Response  Orgname=" + response.OrgName;
                      this.QueryResultTextArea.Text += "...OrgTypeDesc=" + response.OrgTypeDescription;
                      this.QueryResultTextArea.Text += "  OrgPersons:(";
                      if (response.OrgPersons != null)
                      {
                          foreach (OpenSolutions.CoreApiService.Services.Messages.OrgPerson orgpers in response.OrgPersons)
                          {
                              this.QueryResultTextArea.Text += orgpers.FullName;
                              foreach (OpenSolutions.CoreApiService.Services.Messages.OrgPersonRole role in orgpers.OrgPersonRoles)
                              {
                                  this.QueryResultTextArea.Text += " :" + role.RoleDescription;
                              }
                              this.QueryResultTextArea.Text += " / ";
                          }
                      }
                                
                      this.QueryResultTextArea.Text += ")";
                  }
              }
             </code>
             </example>]]></xs:documentation>
