              <xs:appinfo/>
              <xs:documentation>&lt;summary>
            Account Number; routine will find the currency assigned to this account, then find the currencies which it can exchange with.
            If CurrencyCd is not provided then must provide AcctNbr.
            &lt;/summary></xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="CurrencyCode" nillable="true" type="xs:string">
