  <xs:complexType name="EntityAttribHistInquiryRequest">
    <xs:annotation>
      <xs:appinfo/>
      <xs:documentation>&lt;summary>
            This request allows an application to query based on an account, person, org or transaction number, entity attribute code and action code.  
            Of primary importance is the specification of an action code.  This is used in determining whether to return a historical list of records 
            for a given account, person or org and attribute code versus a single active record based on the current post date.
            &lt;/summary></xs:documentation>
    </xs:annotation>
    <xs:complexContent mixed="false">
      <xs:extension base="tns:RequestBase">
        <xs:sequence>
          <xs:element minOccurs="0" name="ActionCode" nillable="true" type="xs:string">
            <xs:annotation>
              <xs:appinfo/>
              <xs:documentation>&lt;summary>
            ALL = Return all rows for the specified entity number and attribute code, ACTIVE = Return the currently active row based on Post Date.  
            This will return at most one row where the effective date is less than or equal to the current post date and the inactive date has not passed.  
            This code is required when entityTypCd = ACCT, PERS or ORG.
            &lt;/summary></xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="CashboxTxnNumber" nillable="true" type="xs:long">
            <xs:annotation>
              <xs:appinfo/>
              <xs:documentation>&lt;summary>
            Attribute identifies the transaction number of a specific CashBox transaction.  Required if entityTypCd = CTXN.
            &lt;/summary></xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="EntityAttributeCode" nillable="true" type="xs:string">
            <xs:annotation>
              <xs:appinfo/>
              <xs:documentation>&lt;summary>
            Attribute indicates the entity attribute code for the request.  If no code is specified, all records for the given account will be returned.  
            Required if actionCd = ACTIVE.
            &lt;/summary></xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="EntityNumber" nillable="true" type="xs:long">
            <xs:annotation>
              <xs:appinfo/>
              <xs:documentation>&lt;summary>
            Attribute indicates the unique identifier for the entity.  It could be PersNbr, OrgNbr or AcctNbr depending on the value supplied in entityTypCd attribute.
            &lt;/summary></xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="EntityTypeCode" nillable="true" type="xs:string">
            <xs:annotation>
              <xs:appinfo/>
              <xs:documentation>&lt;summary>
            Attribute identifies the entity type for the request.  Valid values are PERS, ORG, ACCT and RTXN.
            &lt;/summary></xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="RtxnNumber" nillable="true" type="xs:long">
            <xs:annotation>
              <xs:appinfo/>
              <xs:documentation>&lt;summary>
            Attribute identifies the transaction number of a specific transaction.  Required if entityTypCd = RTXN.
            &lt;/summary></xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
