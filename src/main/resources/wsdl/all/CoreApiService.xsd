          <xs:element minOccurs="0" name="DateBirth" nillable="true" type="xs:dateTime">
            <xs:annotation>
              <xs:appinfo/>
              <xs:documentation>&lt;summary>
            Date of Birth. Format MM/DD/YYYY If doing a set/reset then this value is optional. 
            It is used to help identify the person who is requesting the PIN change. 
            If provided, this value must match the date of birth on record for the TaxId provided.
            &lt;/summary></xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="NewPIN" nillable="true" type="xs:string">
            <xs:annotation>
              <xs:appinfo/>
              <xs:documentation>&lt;summary>
            Required. New PIN. 
            Value must be between 3 and 32 characters. Not case sensitive.
            &lt;/summary></xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="PIN" nillable="true" type="xs:string">
            <xs:annotation>
              <xs:appinfo/>
              <xs:documentation>&lt;summary>
            Current PIN. 
            Required except when doing a set/reset. i.e. Third-party app cannot provide this value because the user forgot the PIN and is trying to reset it.
            &lt;/summary></xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="TaxId" nillable="true" type="xs:string">
            <xs:annotation>
              <xs:appinfo/>
              <xs:documentation>&lt;summary>
            Tax Identification Number. 
            If doing a set/reset then this value is required. 
            It is used to help identify the person who is requesting the PIN change.
            &lt;/summary></xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="ZipCode" nillable="true" type="xs:string">
            <xs:annotation>
              <xs:appinfo/>
              <xs:documentation>&lt;summary>
            Zip Code of Primary ( PRI ) address on file. 
            If doing a set/reset then this value is required. 
            It is used to help identify the person who is requesting the PIN change. 
            This value must match the zip code of the primary address on record for the TaxId provided
            &lt;/summary></xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
