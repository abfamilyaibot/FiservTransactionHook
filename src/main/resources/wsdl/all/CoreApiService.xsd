  <xs:complexType name="CurrencyExchangeRateInquiryRequest">
    <xs:annotation>
      <xs:appinfo/>
      <xs:documentation>&lt;summary>
            Available for use with DNA version 4.1 and higher.
            This transaction is used to calculate a currency exchange. 
            This can be an exchange between the base currency and a foreign currency, or between two foreign currencies using a cross rate.
            &lt;/summary></xs:documentation>
    </xs:annotation>
    <xs:complexContent mixed="false">
      <xs:extension base="tns:RequestBase">
        <xs:sequence>
          <xs:element minOccurs="0" name="Amount" nillable="true" type="xs:double">
            <xs:annotation>
              <xs:appinfo/>
              <xs:documentation>&lt;summary>
            The amount to be exchanged to a different currency.
            &lt;/summary></xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="AmountCurrencyCode" nillable="true" type="xs:string">
            <xs:annotation>
              <xs:appinfo/>
              <xs:documentation>&lt;summary>
            The currency that the amount was provided in.
            &lt;/summary></xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="DealTypeCode" nillable="true" type="xs:string">
            <xs:annotation>
              <xs:appinfo/>
              <xs:documentation>&lt;summary>
            The deal type to be used.  For example, BUY or SELL.
            &lt;/summary></xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="DiscountMethod" nillable="true" type="xs:string">
            <xs:annotation>
              <xs:appinfo/>
              <xs:documentation>&lt;summary>
            Identifies which discount method to use to calculate the discount.  Valid Values: 1,2
            1:  DiscountTypCd
            2.  Combination of EntityTyp and EntityNbr
            &lt;/summary></xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="DiscountTypeCode" nillable="true" type="xs:string">
            <xs:annotation>
              <xs:appinfo/>
              <xs:documentation>&lt;summary>
            If DiscountMethod is set to 1 then a valid DiscountTypCd is required in this tag.  Valid values defined in the DISCOUNTTYP table.
            &lt;/summary></xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="EntityNbr" nillable="true" type="xs:long">
            <xs:annotation>
              <xs:appinfo/>
              <xs:documentation>&lt;summary>
            If DiscountMethod is set to 2 then a valid value is required in this tag. 
            If EntityTyp equals PERS then this tag must contain a valid PersNbr.
            &lt;/summary></xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="EntityType" nillable="true" type="xs:string">
            <xs:annotation>
              <xs:appinfo/>
              <xs:documentation>&lt;summary>
            If DiscountMethod is set to 2 then a valid value is required in this tag.  Valid values: PERS
            &lt;/summary></xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="ExchangeCurrencyCode" nillable="true" type="xs:string">
            <xs:annotation>
              <xs:appinfo/>
              <xs:documentation>&lt;summary>
            The currency that the amount will get converted to.
            &lt;/summary></xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="ExchangeRate" nillable="true" type="xs:decimal">
            <xs:annotation>
              <xs:appinfo/>
              <xs:documentation>&lt;summary>
            The exchange rate that will be used in the transaction.
            If this tag is blank, the rate will be taken from currencyexchratehist.exchrate.  
            The spread (currencyexchspreadhist.spread) and discount rate (currencyexchdiscounthist.fixeddiscount) 
            will also be factored into the exchange when ExchangeRate is blank.  
            &lt;/summary></xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="IncludeDiscountYN" nillable="true" type="xs:boolean">
            <xs:annotation>
              <xs:appinfo/>
              <xs:documentation>&lt;summary>
            Indicates whether or not to include the discount rate which is a discount given to a person or 
            organization when making a foreign exchange transaction. 
            A value of ‘Y’ indicates the discount will be subtracted from the exchange rate, and a value of ‘N’ excludes the discount.
            &lt;/summary></xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="IncludeSpreadYN" nillable="true" type="xs:boolean">
            <xs:annotation>
              <xs:appinfo/>
              <xs:documentation>&lt;summary>
            Indicates whether or not to include the spread rate which is basically 
            the fee the financial institution makes on a foreign exchange transaction. 
            A value of ‘Y’ indicates to that the spread will be added to the exchange rate, and a value of ’N’ exclude the spread.
            &lt;/summary></xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="InstrumentTypeCode" nillable="true" type="xs:string">
            <xs:annotation>
              <xs:appinfo/>
              <xs:documentation>&lt;summary>
            The instrument type to be used: for example, CASH or CHEK.
            &lt;/summary></xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:element name="CurrencyExchangeRateInquiryRequest" nillable="true" type="tns:CurrencyExchangeRateInquiryRequest"/>
  <xs:complexType name="CurrencyExchangeRateInquiryResponse">
    <xs:annotation>
